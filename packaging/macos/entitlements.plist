<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Used only when the .dmg is built with a Developer ID (scripts/bundle.mjs,
  docs/INSTALLERS.md). Notarisation needs the hardened runtime, and under it
  V8 needs JIT and writable-executable memory to run JavaScript at all;
  library validation is relaxed so connectors' native Node add-ons load.
  Untested until the project has a Developer ID: the first signed build is
  where this list is proved or corrected.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
