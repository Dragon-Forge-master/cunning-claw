{
  "model": "claude-opus-5",
  "effort": "high",
  "maxTokens": 8192,
  "persona": {
    "name": "JARVIS",
    "addressUserAs": "sir",
    "userName": "Chris"
  },
  "history": {
    "maxMessages": 60,
    "persist": true
  },
  "webSearch": {
    "enabled": true,
    "maxUses": 5
  },
  "commandPolicy": {
    "autoApprovePatterns": [
      "^(ls|cat|head|tail|grep|find|du|df|free|uptime|date|whoami|hostname|uname|ps|top -b -n 1|sensors|lsblk|ip addr|nmcli( .*)? (status|show)|xdg-open .*|pactl .*|playerctl .*|notify-send .*)( |$)"
    ],
    "denyPatterns": [
      "rm\\s+-rf\\s+/(\\s|$)",
      "mkfs",
      ">\\s*/dev/sd",
      "dd\\s+if=",
      ":\\(\\)\\s*\\{.*\\};:",
      "shutdown|reboot|poweroff",
      "passwd",
      "chmod\\s+777\\s+/"
    ],
    "timeoutMs": 30000,
    "approvalTimeoutMs": 120000
  },
  "server": {
    "port": 3900,
    "host": "127.0.0.1"
  },
  "voice": {
    "enabled": true,
    "engine": "auto",
    "maxChars": 1200,
    "piper": {
      "model": "voices/en_GB-alan-medium.onnx",
      "player": "paplay",
      "sampleRate": 22050,
      "lengthScale": 1.0,
      "noiseScale": 0.667,
      "noiseWScale": 0.8,
      "sentenceSilence": 0.25,
      "volume": 1.0
    },
    "spd": {
      "language": "en-gb",
      "voiceName": "English (Great Britain)+Edward",
      "rate": -10,
      "pitch": 0,
      "volume": 0
    }
  },
  "browser": {
    "enabled": true,
    "binary": "",
    "debugPort": 9222,
    "timeoutMs": 20000,
    "extraFlags": [],
    "requireApprovalFor": [
      "browser_click",
      "browser_type"
    ]
  },
  "desktop": {
    "enabled": true,
    "maxImageWidth": 1400,
    "requireApprovalFor": [
      "press_keys",
      "type_on_desktop"
    ]
  },
  "http": {
    "allowlist": [
      "api.github.com",
      "api.open-meteo.com",
      "geocoding-api.open-meteo.com",
      "*.googleapis.com",
      "127.0.0.1",
      "localhost"
    ],
    "timeoutMs": 20000,
    "maxResponseChars": 12000
  },
  "homeAssistant": {
    "enabled": false,
    "baseUrl": "http://homeassistant.local:8123",
    "tokenEnv": "HA_TOKEN"
  },
  "coherence": {
    "ouroborosLimit": 2,
    "maxIterations": 25
  },
  "heartbeat": {
    "enabled": true,
    "intervalMinutes": 30
  },
  "routing": {
    "enabled": true,
    "timeoutMs": 120000,
    "cheapMaxChars": 200,
    "cheap": {
      "enabled": false,
      "provider": "openai-compat",
      "model": "google/gemini-2.5-flash",
      "baseUrl": "https://openrouter.ai/api/v1",
      "apiKeyEnv": "OPENROUTER_API_KEY",
      "effort": "low"
    },
    "cheapPatterns": [
      "^(what('s| is) the )?time",
      "^(what('s| is) the )?date",
      "volume",
      "^(set|start) a? ?timer",
      "^(system )?(status|telemetry|cpu|memory|disk|uptime)",
      "^(mute|unmute|pause|play|next track|previous track)",
      "^(hello|hi|hey|good (morning|evening|afternoon))",
      "^(thanks|thank you|cheers)"
    ],
    "strongPatterns": [
      "email|inbox|gmail|mail",
      "browse|website|web|url|http|search|look up|google",
      "run |execute|command|shell|terminal|install|delete|remove",
      "screenshot|screen|look at|see ",
      "write |create |edit |file",
      "buy|pay|send|post|publish|tweet"
    ],
    "pricePerMTok": {
      "default": {
        "in": 5.0,
        "out": 25.0
      },
      "claude-opus-5": {
        "in": 5.0,
        "out": 25.0
      },
      "claude-haiku-4-5": {
        "in": 1.0,
        "out": 5.0
      },
      "google/gemini-2.5-flash": {
        "in": 0.3,
        "out": 2.5
      }
    }
  }
}