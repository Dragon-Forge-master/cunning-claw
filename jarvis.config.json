{
  "model": "claude-opus-5",
  "effort": "high",
  "maxTokens": 8192,
  "persona": {
    "name": "JARVIS",
    "addressUserAs": "sir",
    "userName": "Chris"
  },
  "history": {
    "maxMessages": 60,
    "persist": true
  },
  "webSearch": {
    "enabled": true,
    "maxUses": 5
  },
  "commandPolicy": {
    "autoApprovePatterns": [
      "^(ls|cat|head|tail|grep|find|du|df|free|uptime|date|whoami|hostname|uname|ps|top -b -n 1|sensors|lsblk|ip addr|nmcli( .*)? (status|show)|xdg-open .*|pactl .*|playerctl .*|notify-send .*)( |$)"
    ],
    "denyPatterns": [
      "rm\\s+-rf\\s+/(\\s|$)",
      "mkfs",
      ">\\s*/dev/sd",
      "dd\\s+if=",
      ":\\(\\)\\s*\\{.*\\};:",
      "shutdown|reboot|poweroff",
      "passwd",
      "chmod\\s+777\\s+/"
    ],
    "timeoutMs": 30000,
    "approvalTimeoutMs": 120000
  },
  "server": {
    "port": 3900,
    "host": "127.0.0.1"
  },
  "voice": {
    "enabled": true,
    "engine": "auto",
    "maxChars": 1200,
    "piper": {
      "model": "voices/en_GB-alan-medium.onnx",
      "player": "paplay",
      "sampleRate": 22050,
      "lengthScale": 1.0,
      "noiseScale": 0.667,
      "noiseWScale": 0.8,
      "sentenceSilence": 0.25,
      "volume": 1.0
    },
    "spd": {
      "language": "en-gb",
      "voiceName": "English (Great Britain)+Edward",
      "rate": -10,
      "pitch": 0,
      "volume": 0
    }
  },
  "browser": {
    "enabled": true,
    "binary": "",
    "debugPort": 9222,
    "timeoutMs": 20000,
    "extraFlags": [],
    "requireApprovalFor": [
      "browser_click",
      "browser_type"
    ]
  },
  "desktop": {
    "enabled": true,
    "maxImageWidth": 1400,
    "requireApprovalFor": [
      "press_keys",
      "type_on_desktop"
    ]
  },
  "http": {
    "allowlist": [
      "api.github.com",
      "api.open-meteo.com",
      "geocoding-api.open-meteo.com",
      "*.googleapis.com",
      "127.0.0.1",
      "localhost"
    ],
    "timeoutMs": 20000,
    "maxResponseChars": 12000
  },
  "homeAssistant": {
    "enabled": false,
    "baseUrl": "http://homeassistant.local:8123",
    "tokenEnv": "HA_TOKEN"
  },
  "coherence": {
    "ouroborosLimit": 2,
    "maxIterations": 25
  },
  "heartbeat": {
    "enabled": true,
    "intervalMinutes": 30
  },
  "brains": {
    "default": "core",
    "heartbeat": "pulse",
    "fallbacks": [
      "pulse",
      "cheap"
    ],
    "catalog": [
      {
        "id": "core",
        "label": "Core",
        "provider": "anthropic",
        "model": "claude-opus-5",
        "effort": "high",
        "thinking": true
      },
      {
        "id": "pulse",
        "label": "Pulse",
        "provider": "anthropic",
        "model": "claude-haiku-4-5",
        "effort": "low",
        "maxTokens": 2048,
        "thinking": false
      },
      {
        "id": "cheap",
        "label": "Cheap",
        "provider": "openai",
        "model": "gpt-4o-mini",
        "baseUrl": "https://api.openai.com/v1",
        "apiKeyEnv": "OPENAI_API_KEY"
      }
    ]
  },
  "brain": {
    "provider": "anthropic",
    "openai": {
      "baseUrl": "https://api.openai.com/v1",
      "model": "gpt-4o-mini",
      "apiKeyEnv": "OPENAI_API_KEY"
    }
  },
  "routing": {
    "enforceTrustedBrain": true,
    "trustedBrains": [
      "core"
    ]
  }
}