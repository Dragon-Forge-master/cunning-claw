{
  "mcpServers": {
    "canva": {
      "type": "http",
      "url": "https://mcp.canva.com/mcp"
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "search": {
      "command": "npx",
      "args": [
        "-y",
        "@oevortex/ddg_search"
      ],
      "readTools": [
        "web-search"
      ]
    }
  }
}