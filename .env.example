# Default roster (flash / lite / pro / nano / deepseek) — OpenRouter
OPENROUTER_API_KEY=sk-or-...

# Optional: only if you put an Anthropic brain back in claw.config.json
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: only if a catalog entry uses the openai.com API directly
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Telegram — BOTH required. Token alone is ignored so a leaked bot cannot
# be talked to by strangers. Message the bot /whoami to learn your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: extra operators by Telegram USER id. Only operators are obeyed,
# even in a group whose id is in TELEGRAM_CHAT_ID; your own private-chat id
# already counts. Approval cards only ever go to private chats.
TELEGRAM_OPERATOR_ID=

# Discord — same rule: the token alone is ignored. In the Developer Portal
# turn on the "Message Content" privileged intent for the bot (without it
# every message arrives empty), invite it to your server, then message it
# /whoami and put the id it replies with here.
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_ID=
# Approval cards go to a DM with each allowed user, never a server channel,
# so there is no channel to configure (DISCORD_CHANNEL_ID is no longer read).

# ntfy — push alerts to the free ntfy app (iOS/Android), no account needed.
# Outbound only: approval alerts say where to answer, they carry no buttons.
# The topic IS the password: on public ntfy.sh anyone who guesses the name
# reads it, so make it long and random (npm run doctor suggests one) and keep
# it out of git. NTFY_TOKEN is optional, for a protected topic or a
# self-hosted server (set ntfy.server in claw.config.json).
NTFY_TOPIC=
NTFY_TOKEN=

# Home Assistant — a long-lived access token (HA: your profile → Security →
# Long-lived access tokens). Also set homeAssistant.enabled and baseUrl in
# claw.config.json. The same token opens the live-event socket that watches
# the doorbell; npm run doctor checks it is accepted.
HA_TOKEN=
