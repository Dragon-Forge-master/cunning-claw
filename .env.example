# Required unless brain.provider is "openai" in jarvis.config.json
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI-compatible brain (OpenAI, OpenRouter, LocalAI, vLLM, …)
# Set "brain.provider": "openai" in jarvis.config.json, then:
OPENAI_API_KEY=
# Optional override of brain.openai.baseUrl (e.g. https://openrouter.ai/api/v1)
# OPENAI_BASE_URL=

# Telegram — BOTH required. Token alone is ignored so a leaked bot cannot
# be talked to by strangers. Message the bot /whoami to learn your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
