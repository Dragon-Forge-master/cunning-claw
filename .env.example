# Required for core + pulse (Anthropic brains)
ANTHROPIC_API_KEY=sk-ant-...

# Required only if you use the "cheap" brain (or any openai provider in the catalog)
OPENAI_API_KEY=
# Optional default base URL when a catalog entry omits baseUrl
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Telegram — BOTH required. Token alone is ignored so a leaked bot cannot
# be talked to by strangers. Message the bot /whoami to learn your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
