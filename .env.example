# Default roster (flash / lite / pro / nano / deepseek) — OpenRouter
OPENROUTER_API_KEY=sk-or-...

# Optional: only if you put an Anthropic brain back in claw.config.json
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: only if a catalog entry uses the openai.com API directly
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Telegram — BOTH required. Token alone is ignored so a leaked bot cannot
# be talked to by strangers. Message the bot /whoami to learn your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord — same rule: the token alone is ignored. In the Developer Portal
# turn on the "Message Content" privileged intent for the bot (without it
# every message arrives empty), invite it to your server, then message it
# /whoami and put the id it replies with here.
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_ID=
# Optional: the channel where approval cards for work started on the HUD
# should land. Defaults to the last channel you spoke in.
DISCORD_CHANNEL_ID=
