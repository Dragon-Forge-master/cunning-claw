{
  "id": "/pocket/",
  "name": "Pocket Claw",
  "short_name": "Pocket Claw",
  "description": "Your Cunning Claw from your phone: talk to it, answer its approval cards with your fingerprint, and share receipts to it.",
  "lang": "en-GB",
  "start_url": "/pocket/",
  "scope": "/pocket/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0a111c",
  "theme_color": "#0a111c",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "/pocket/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/pocket/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/pocket/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/pocket/icons/mark.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Talk", "short_name": "Talk", "description": "Say something to the claw", "url": "/pocket/#talk",
      "icons": [{ "src": "/pocket/icons/talk-96.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Snap receipt", "short_name": "Receipt", "description": "Photograph a receipt for the claw to file", "url": "/pocket/#snap",
      "icons": [{ "src": "/pocket/icons/snap-96.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Approvals", "short_name": "Approvals", "description": "The cards waiting for your answer", "url": "/pocket/#approvals",
      "icons": [{ "src": "/pocket/icons/approvals-96.png", "sizes": "96x96", "type": "image/png" }] }
  ],
  "share_target": {
    "action": "/pocket/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "file", "accept": ["image/*", "application/pdf", ".pdf", ".jpg", ".jpeg", ".png", ".webp", ".heic"] }]
    }
  }
}
