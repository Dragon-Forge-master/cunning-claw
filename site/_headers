/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; frame-ancestors 'none'
# The update feed (src/updates.ts). Claws that said yes ask once a day; an
# hour's cache means a new release reaches every one of them within the day
# and a mistake in the file can be undone just as fast. No CORS header: the
# claw fetches it server-side, and no browser page has any need to read it.
/latest.json
  Cache-Control: public, max-age=3600
  Content-Type: application/json; charset=utf-8

# Written for language models (llmstxt.org). They hold a Welsh line with a
# circumflex and a middle dot, so the charset is said out loud rather than
# left to whatever a fetcher guesses for text/plain.
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# Uploaded with the site because the deploy is the whole folder, and neither
# is a page: a search result for the deploy notes helps nobody.
/README.md
  X-Robots-Tag: noindex
/wrangler.toml
  X-Robots-Tag: noindex

# Pocket Claw, the phone app (site/pocket/, copied from public/pocket/ by
# `npm run site:pocket`). Its own policy, stricter than the homepage's: its
# own files and nothing else, no inline anything, no fonts or Turnstile, and
# the one place it may connect to beyond itself is the relay. Pages joins two
# rules' values for one header with a comma, which for a CSP means both
# policies apply at once, so the site-wide ones are detached first.
/pocket/*
  ! Content-Security-Policy
  ! Referrer-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' wss://pocket-relay.cunningclaw.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(self), microphone=(self), geolocation=()
  Cross-Origin-Opener-Policy: same-origin
  # An app shell, not a page to land on from a search: it has no words for a
  # stranger, and the home page's own section is what should be found.
  X-Robots-Tag: noindex
